# 이 파일을 .env 로 복사한 뒤 필요한 값만 채우세요. 대개는 비워 두면 됩니다.

# ── API 주소 ────────────────────────────────────────────
# 비워 두면 같은 출처(/api)로 보냅니다. 개발에서는 Vite 프록시가, 운영에서는
# nginx 가 /api 를 백엔드로 넘깁니다. 세션이 쿠키라 같은 출처가 가장 덜 까다롭습니다.
#
# 다른 호스트의 백엔드를 보려는 경우에만 채우세요. 그때는 그 서버의
# lab-calendar.web.allowed-origins 에 이 프론트 주소가 들어 있어야 합니다.
VITE_API_BASE_URL=

# ── 개발 서버 프록시 대상 ────────────────────────────────
# 백엔드를 8080 이 아닌 곳에 띄웠을 때만 채우세요.
VITE_API_PROXY_TARGET=

# ── 목 API 서버 ─────────────────────────────────────────
# true 면 브라우저 안에서 가짜 백엔드(MSW)가 API 를 받습니다. 백엔드를 띄우지 않고
# 화면을 보거나 데이터를 눌러 볼 때 켜세요. `npm run dev:mock` 이 .env.mock 으로
# 이 값을 켜 주므로, 보통 여기서 직접 채울 일은 없습니다.
#
# 개발 빌드에서만 동작합니다 — 운영 빌드에서는 true 를 넣어도 무시되고, 목 코드와
# 목 데이터는 번들에 실리지 않습니다.
VITE_ENABLE_MSW=
