# 백엔드 API 주소
VITE_API_BASE_URL=http://localhost:8080

# ── 아래는 개발용 스위치 ────────────────────────────────
# 백엔드가 나오기 전까지 프론트는 더미 어댑터(src/api/dummyDb.ts)로 동작한다.
# 값을 즉시 돌려주기 때문에 로딩·에러 화면을 볼 방법이 없어, 아래 값으로
# 지연과 실패를 흉내 낼 수 있다. 바꾼 뒤에는 dev 서버를 다시 띄워야 한다.
# 실제 API 를 붙이면 dummyDb.ts 와 함께 사라진다.

# 모든 더미 응답에 걸리는 지연(ms). 로딩 스켈레톤 확인용.
VITE_DUMMY_DELAY_MS=

# 조회를 실패시킬 대상. categories, events, projects 를 쉼표로 구분. all 이면 전부.
VITE_DUMMY_FAIL=

# 생성·수정·삭제를 실패시킬 대상. 값 형식은 VITE_DUMMY_FAIL 과 같다.
VITE_DUMMY_FAIL_WRITE=
